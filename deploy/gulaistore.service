[Unit]
Description=Gulai Store AI Assistant (Telegram + Avito)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gulaistore
Group=gulaistore
WorkingDirectory=/opt/gulaistore
ExecStart=/opt/gulaistore/.venv/bin/python main.py
EnvironmentFile=/opt/gulaistore/.env
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gulaistore

# Safety hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
