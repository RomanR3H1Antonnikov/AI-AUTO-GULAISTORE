# OpenAI
OPENAI_API_KEY=sk-...

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAF...

# Your personal Telegram ID (use @userinfobot to find it)
OWNER_TELEGRAM_ID=123456789

# ── Avito API (Phase 2) ────────────────────────────────────────────────────────
# OAuth2 client_credentials — из личного кабинета Авито → Настройки → Avito API
AVITO_CLIENT_ID=your_client_id_here
AVITO_CLIENT_SECRET=your_client_secret_here

# Числовой ID вашего аккаунта продавца на Авито
# Найти: GET https://api.avito.ru/core/v1/accounts/self (после получения токена)
AVITO_USER_ID=123456789

# Публичный HTTPS URL, на который Авито будет слать webhook-уведомления
# Для локальной разработки: ngrok http 8080 → вставить сюда https://xxxx.ngrok.io/webhook/avito
# Для прода: ваш домен, например https://bot.gulaistore.ru/webhook/avito
AVITO_WEBHOOK_URL=https://your-domain.ru/webhook/avito

# Порт внутреннего webhook-сервера (FastAPI)
AVITO_WEBHOOK_PORT=8080
